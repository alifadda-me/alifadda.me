---
import PageLayout from "@/layouts/Base.astro";
import LoomVault from "@/components/loom/LoomVault";
import { isAuthorized } from "@/utils/auth";

export const prerender = false;

const queryKey = Astro.url.searchParams.get("key");
const effectiveKey = (queryKey && isAuthorized(queryKey)) ? queryKey : "";
---

<PageLayout meta={{ title: "Video Vault - Ali Fadda" }} wide={true}>
	<div class="space-y-6 w-full">
		<LoomVault client:load initialKey={effectiveKey} />
	</div>
</PageLayout>

